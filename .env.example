# Copy to `.env` in this directory. Compose reads this file automatically.
#
# Local: keep VITE_API_BASE_URL empty and open http://localhost:8081
# Production: set a strong JWT_SECRET (openssl rand -hex 32), then:
#   docker compose up --build -d --scale crawler=2
# Point host nginx at infrastructure/nginx/prod.conf
# Optional: VITE_API_BASE_URL=https://api.insta-demo.fybud.com (rebuild frontend)

BIND=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=4001
POSTGRES_PORT=5433
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
EDGE_PORT=8081

POSTGRES_USER=crafter
POSTGRES_PASSWORD=crafter
POSTGRES_DB=crafter
RABBITMQ_USER=crafter
RABBITMQ_PASSWORD=crafter

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-value
CORS_ORIGIN=http://localhost:8081,http://localhost:8080,http://localhost:5173,http://insta-demo.fybud.com,https://insta-demo.fybud.com

# Empty locally so the browser calls /api on the same origin (edge nginx).
# Production: https://api.insta-demo.fybud.com  (rebuild frontend after changing this)
VITE_API_BASE_URL=

TARGET_QUALIFIED=100
CRAWLER_REPLICAS=2
